<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:Style src="MapEditor.uss" />
  <ui:VisualElement class="map-root">
    <ui:VisualElement class="toolbar">
      <uie:ObjectField name="map" label="맵" class="map-picker" />
      <ui:Button name="new" text="새 맵" />
      <ui:Button name="save" text="저장" />
      <ui:VisualElement class="toolbar-gap" />
      <ui:Button name="undo" text="↶ 실행 취소" />
      <ui:Button name="redo" text="↷ 다시 실행" />
      <ui:VisualElement class="toolbar-gap" />
      <ui:Toggle name="show-all-ranges" text="모든 적 범위" tooltip="켜면 모든 적의 인식·공격 범위를 표시합니다. 끄면 마우스를 올리거나 선택한 적만 표시합니다." />
      <ui:Button name="reset-view" text="화면 맞춤" />
    </ui:VisualElement>
    <ui:TwoPaneSplitView name="split" orientation="Vertical" fixed-pane-index="1" fixed-pane-initial-dimension="250" class="body">
      <ui:VisualElement class="work-area">
      <ui:VisualElement name="tool-rail" class="tool-rail" />
      <ui:VisualElement name="canvas-host" class="canvas-host">
        <ui:Label name="legend" class="legend" text="노란 테두리: 시작 위치 · 삼각형: 적과 진행 방향 · 범위: 노란 테두리=인식, 빨간 칸=공격, 빨간 테두리=인식 후 추가 공격 · 자홍: 누락 데이터" />
      </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="bottom-panel">
        <ui:VisualElement name="cell-info" class="cell-info">
          <ui:Label text="선택한 칸" class="section-title" />
          <ui:Label name="selection" text="선택 도구(V)나 오른쪽 클릭으로 칸을 선택하세요." class="help" />
          <ui:VisualElement name="enemy-actions" class="row">
            <ui:Button name="rotate-ccw" text="↺ 왼쪽 회전" />
            <ui:Button name="rotate-cw" text="↻ 오른쪽 회전 (R)" />
            <ui:Button name="delete-enemy" text="적 삭제 (Del)" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:TabView name="tabs" class="tabs">
          <ui:Tab name="tab-paint" label="칠하기">
            <ui:ScrollView class="tab-body">
              <ui:Label text="이동 바닥" class="section-title" />
              <ui:VisualElement name="floor-palette" class="palette" />
              <ui:VisualElement name="floor-settings" />
              <ui:Button name="new-floor" text="새 바닥 만들기" />
              <uie:ObjectField name="floor-asset" label="기존 바닥" />
              <ui:Button name="add-floor" text="팔레트에 등록" />
              <ui:Label text="모든 바닥은 이동 가능합니다. 바닥 설정은 같은 에셋을 쓰는 맵에 함께 적용됩니다. 에디터는 색상으로, Scene은 지정 재질로 표시합니다. 지운 칸은 이동할 수 없습니다." class="help" />
            </ui:ScrollView>
          </ui:Tab>
          <ui:Tab name="tab-enemy" label="적">
            <ui:ScrollView class="tab-body">
              <ui:Label text="배치할 적" class="section-title" />
              <ui:VisualElement name="enemy-palette" class="palette" />
              <ui:Button name="default-enemies" text="기본 적 프리팹 준비" />
              <ui:Label text="배치 방향" class="section-title" />
              <ui:VisualElement name="facing-buttons" class="row" />
              <ui:Label name="enemy-summary" class="help" />
              <ui:Label text="적 배치(N) 도구로 칸을 클릭합니다. 배치 중 R로 방향을 돌립니다. 이미 놓은 적은 선택 도구(V)로 골라 회전·삭제합니다. 바닥을 지우면 그 칸의 적도 지워집니다." class="help" />
            </ui:ScrollView>
          </ui:Tab>
          <ui:Tab name="tab-map" label="맵">
            <ui:ScrollView class="tab-body">
              <ui:Label text="크기" class="section-title" />
              <ui:IntegerField name="width" label="가로 (칸)" value="12" />
              <ui:IntegerField name="height" label="세로 (칸)" value="12" />
              <ui:Button name="resize" text="크기 적용 (1~64)" />
              <ui:Label text="배경과 기본 바닥" class="section-title" />
              <ui:VisualElement name="map-settings" />
              <ui:Label text="배경 바닥은 이동 영역과 별개입니다." class="help" />
              <ui:Button name="environment" text="환경 설정 (Inspector)" />
              <ui:Foldout text="조작 방법" value="false">
                <ui:Label class="help" text="왼쪽 클릭·드래그: 현재 도구 적용
오른쪽 클릭: 칸 선택(정보 보기)
가운데 드래그: 화면 이동 · 휠: 확대·축소
도구 단축키(캔버스나 도구 버튼을 누른 뒤): B 칠하기 · E 지우기 · S 시작 위치 · N 적 배치 · X 적 지우기 · V 선택
R: 배치 방향 회전 또는 선택한 적 회전 · Delete: 선택한 적 삭제
F: 화면 맞춤" />
              </ui:Foldout>
            </ui:ScrollView>
          </ui:Tab>
          <ui:Tab name="tab-validate" label="검증">
            <ui:ScrollView class="tab-body">
              <ui:IntegerField name="max-states" label="최대 탐색 상태 수" value="200000" tooltip="넘으면 탐색을 멈추고 불완전한 결과를 보여 줍니다. 클수록 정확하지만 오래 걸리고 메모리를 더 씁니다. 대략 초당 1만 상태 안팎입니다." />
              <ui:Button name="analyze" text="맵 검증 실행" />
              <ui:Label name="analysis-result" text="" class="help result" />
              <ui:Label text="가능한 모든 행동 순서를 탐색해 클리어 가능 여부, 최단 경로, 가장 빠른 패배, 승리 불가 상태를 알려 줍니다. 경로는 정답이므로 플레이 전에는 보지 않는 편이 좋습니다. 맵을 수정하면 결과는 지워집니다." class="help" />
            </ui:ScrollView>
          </ui:Tab>
        </ui:TabView>
      </ui:VisualElement>
    </ui:TwoPaneSplitView>
    <ui:VisualElement name="status-bar" class="status-bar">
      <ui:Label name="status-dirty" class="chip" />
      <ui:Label name="status-size" class="chip" />
      <ui:Label name="status-enemies" class="chip" />
      <ui:Label name="status-errors" class="chip" />
      <ui:Label name="status-hover" class="chip" />
      <ui:Label name="status" class="status-message" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
