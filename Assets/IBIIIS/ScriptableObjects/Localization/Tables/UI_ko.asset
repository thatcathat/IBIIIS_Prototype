    m_Metadata:
      m_Items: []
  - m_Id: 6686662668
    m_Localized: "\uC804\uD22C \uC52C\uC5D0 \uC804\uD22C(Grid Map Player)\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6686662669
    m_Localized: "\uC804\uD22C\uB97C \uC2DC\uC791\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      Console\uC758 [IBIIIS] \uC624\uB958(\uB9F5 \uC124\uC815)\uB97C \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 6686662670
    m_Localized: "\uD074\uB9AC\uC5B4 \uAE30\uB85D\uC744 \uC800\uC7A5\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6686662671
    m_Localized: "\uB2E4\uC2DC \uC2DC\uB3C4\uD588\uC9C0\uB9CC \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.
      \uD655\uC778\uC744 \uB204\uB974\uBA74 \uC800\uC7A5\uD558\uC9C0 \uC54A\uACE0
      \uBBF8\uB2C8\uB9F5\uC73C\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6686662672
    m_Localized: "\uBBF8\uB2C8\uB9F5 \uC52C\uC744 \uBD88\uB7EC\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 6686662673
    m_Localized: "\uBBF8\uB2C8\uB9F5 | \uC774\uB3D9 {move} | \uB2EC\uB9AC\uAE30 {dash}(\uB204\uB974\uACE0
      \uC788\uAE30) | \uAD6C\uB974\uAE30 {roll} | \uC0C1\uD638\uC791\uC6A9 {interact}"
